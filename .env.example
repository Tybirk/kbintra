# Django
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SITE_URL=https://yourdomain.com

# Optional: dedicated key for signing short-lived /media URLs. Defaults to
# SECRET_KEY if unset (no action needed). Set a separate value only if you want
# to rotate media URL signatures independently of SECRET_KEY.
MEDIA_URL_SIGNING_KEY=

# Message encryption (required in production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGES_ENCRYPTION_KEY=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Web Push notifications (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@yourdomain.com

# Optional: S3 storage (leave S3_BACKUP_BUCKET empty to disable)
# Used for: Litestream continuous DB replication + media file sync
S3_BACKUP_BUCKET=
S3_BACKUP_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
S3_BACKUP_REGION=auto
S3_BACKUP_PREFIX=media/

GOOGLE_DRIVE_API_KEY=...
GOOGLE_DRIVE_MENU_FOLDER_ID=

# Giphy integration (optional — get a free API key at developers.giphy.com)
# This is a frontend build-time variable; pass as build-arg: VITE_GIPHY_API_KEY=...
VITE_GIPHY_API_KEY=

# Email
# Dev defaults to the console backend. In production, send via Cloudflare Email Service:
EMAIL_BACKEND=apps.notifications.email_backend.CloudflareEmailBackend
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_EMAIL_API_TOKEN=your-token-scoped-to-email_sending_write
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Generic SMTP fallback (only used if EMAIL_BACKEND is set to Django's SMTP backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Treasurer/economy inbox notified whenever a new udlæg (expense) is submitted.
# Leave empty to disable the notice (e.g. in dev). On the test site (kbintra.top)
# point this at a throwaway inbox — test submissions send real email.
ECONOMY_EMAIL=
# Max raw bytes of receipts attached to the udlæg notice (also the per-file cap
# on receipt uploads). 18000000 fits Cloudflare's 25 MiB cap for *verified*
# destination addresses (Email Routing → Destination addresses) after base64.
# Drop to 3500000 if ECONOMY_EMAIL is not a verified destination (5 MiB cap).
EXPENSE_EMAIL_MAX_ATTACHMENT_BYTES=18000000

# Sentry error tracking (optional)
# Use separate DSNs for backend and frontend (two Sentry projects)
SENTRY_DSN=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=production

# Monitoring
# Dozzle log viewer at /dozzle (protected by basic auth)
# Generate with: htpasswd -nbB admin yourpassword | sed 's/\$/\$\$/g'
DOZZLE_BASICAUTH_USERS=admin:$$2y$$05$$hashedpasswordhere
# Uptime Kuma status page — needs its own subdomain + Cloudflare Tunnel route
UPTIME_KUMA_HOST=status.yourdomain.com
